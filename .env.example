# Copy to .env.local for development. Never commit real values.

# Neon: the connection string from the Neon dashboard.
# For local development without Neon, use a folder instead:
#   DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=pglite:./.data/pglite

# Public site address, used in sign-in emails. http://localhost:3000 locally.
APP_URL=https://dolphub.tech

# Who may sign up. Comma-separated, exact domain match.
PCU_EMAIL_DOMAINS=pcu.edu.ph

# Resend. Leave the key empty locally to print sign-in links to the terminal.
# The domain in EMAIL_FROM must be verified in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=PCU Community <login@dolphub.tech>
# Stay under Resend's free tier of 100 emails a day.
DAILY_EMAIL_CAP=90
# Sign-in links one network may request per hour. Campus Wi-Fi shares one address.
SIGNIN_LINKS_PER_NETWORK_PER_HOUR=30
# Key for hashing requester networks, at least 16 random characters.
# Optional: without it, a key derived from DATABASE_URL is used.
RATE_LIMIT_SECRET=

# Nightly cleanup at /api/cron/cleanup, scheduled in vercel.json. At least 16 random characters.
# Vercel sends it with each scheduled request. Without it, cleanup never runs.
CRON_SECRET=

# Admin MCP server at /api/mcp/admin. Set both or neither. The token is at least 32 random
# characters; the email is an admin's sign-in address, and every write is audited as them.
ADMIN_MCP_TOKEN=
ADMIN_MCP_EMAIL=

# Cloudflare R2. Leave all empty locally to keep images in memory.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Google sign-in. Optional: without both, "Continue with Google" says it is unavailable.
# Create an OAuth client (Web application) in Google Cloud and register
# APP_URL/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
