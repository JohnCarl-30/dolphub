# Copy to .env.local for development. Never commit real values.

# Neon: use the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Who may sign up. Comma-separated, exact domain match.
PCU_EMAIL_DOMAINS=pcu.edu.ph

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pcu-community-images
R2_PUBLIC_BASE_URL=https://images.example.com
